# Bling API v3 — credenciais (copie para .env e preencha)
#
# O token é renovado automaticamente e gravado de volta no .env.

# Host da API: api.bling.com.br (produção) ou www.bling.com.br
BLING_HOST=api.bling.com.br

BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=

# Cache; preenchido/atualizado automaticamente no refresh
BLING_ACCESS_TOKEN=
BLING_EXPIRES_AT=0

# Loja virtual (tema) — ver specs/loja-virtual.md. Não são segredos; ficam aqui para
# a documentação e os arquivos versionados serem agnósticos de marca.
# Prefixo de arquivos e classes próprios do tema (ex.: acme -> css/acme-extras.css, .acme-sold)
THEME_PREFIX=
# Marcador dos comentários nas edições de arquivos originais do tema (ex.: ACME. -> comentários "ACME.: ...")
THEME_MARK=
